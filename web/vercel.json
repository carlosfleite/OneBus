{
  "headers": [
    {
      "source": "/(index.html|onebus_sw.js|flutter_bootstrap.js|version.json|manifest.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(assets|canvaskit|icons)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
